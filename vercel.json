{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "redirects": [
    { "source": "/about", "destination": "/#about", "permanent": true },
    { "source": "/skills", "destination": "/#tech-stack", "permanent": true },
    { "source": "/education", "destination": "/#education", "permanent": true },
    { "source": "/certifications", "destination": "/#certifications", "permanent": true },
    { "source": "/achievements", "destination": "/#achievements", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-NutWs5LfpsW/6tTRkcNdhoPtgiSecDKozQ0DS/RbHyw='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
